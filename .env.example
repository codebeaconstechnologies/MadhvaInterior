# Cloudflare Pages Function environment variables (functions/api/contact.ts)
#
# These are NOT read by Vite/the frontend — the frontend never sees them.
# Set them as Cloudflare Pages secrets/variables (Dashboard → your project →
# Settings → Environment variables), or locally via `wrangler pages secret put`
# / a `.dev.vars` file when running `wrangler pages dev`.

# Secret API key from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# The studio inbox that should receive enquiries
CONTACT_EMAIL=madhvadesignstudio@gmail.com

# Verified sender identity in Resend, e.g. "Madhva Interiors <enquiries@yourdomain.com>"
# Must be on a domain you have verified in Resend — see README for setup.
FROM_EMAIL=Madhva Interiors <enquiries@yourdomain.com>
