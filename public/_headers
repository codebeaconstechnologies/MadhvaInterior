# Cloudflare Pages response headers.

# Basic security headers for every response. (A Content-Security-Policy is
# left out on purpose: Google Analytics, Google Fonts and the Maps embed
# would all need allow-listing, and a wrong policy silently breaks them.)
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=31536000

# Built JS/CSS have content hashes in their names, so they never change.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Photos can be swapped under the same name, so cache for a day and
# revalidate in the background after that.
/images/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# The pages.dev copies of the site (and per-deploy preview links) stay out of
# search results; only www.madhvainteriors.com should be indexed.
https://:project.pages.dev/*
  X-Robots-Tag: noindex

https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex
